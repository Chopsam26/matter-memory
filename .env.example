# Copy to .env.local and adjust if needed.
#
# Port 5433, not 5432: this machine has a Homebrew Postgres 14 that already
# holds 5432. The Docker container maps host 5433 -> container 5432.
# Any psql you run by hand needs -p 5433 for the same reason.
DATABASE_URL=postgresql://matter:matter@localhost:5433/matter_memory

# Ollama runs natively on the host, not in Docker Compose.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b
